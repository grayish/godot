; Engine configuration file.
; It's generated by Godot and edited by hand for the learning project.
config_version=5

[application]

config/name="05 서버와 렌더링 파이프라인 실습"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4")

[autoload]

Log="*res://log.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"

[shader_globals]

lab_time={
"type": "float",
"value": 0.0
}
