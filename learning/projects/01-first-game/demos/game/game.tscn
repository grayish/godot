[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://demos/game/game.gd" id="1_game"]
[ext_resource type="PackedScene" path="res://demos/game/player.tscn" id="2_player"]
[ext_resource type="Script" path="res://demos/game/mob_spawner.gd" id="3_spawner"]
[ext_resource type="Script" path="res://demos/game/hud.gd" id="4_hud"]

[node name="Game" type="Node2D"]
script = ExtResource("1_game")

[node name="Player" parent="." instance=ExtResource("2_player")]
position = Vector2(480, 260)

[node name="MobSpawner" type="Node" parent="."]
script = ExtResource("3_spawner")

[node name="SpawnTimer" type="Timer" parent="MobSpawner"]
wait_time = 0.5

[node name="ScoreTimer" type="Timer" parent="."]

[node name="StartTimer" type="Timer" parent="."]
wait_time = 1.5
one_shot = true

[node name="HUD" type="CanvasLayer" parent="."]
script = ExtResource("4_hud")

[node name="ScoreLabel" type="Label" parent="HUD"]
offset_top = 12.0
offset_right = 960.0
offset_bottom = 62.0
theme_override_font_sizes/font_size = 36
text = "0"
horizontal_alignment = 1

[node name="MessageLabel" type="Label" parent="HUD"]
offset_top = 190.0
offset_right = 960.0
offset_bottom = 260.0
theme_override_font_sizes/font_size = 44
text = "닷지!"
horizontal_alignment = 1

[node name="RestartButton" type="Button" parent="HUD"]
visible = false
offset_left = 390.0
offset_top = 300.0
offset_right = 570.0
offset_bottom = 350.0
text = "다시 시작"

[connection signal="hit" from="Player" to="." method="_on_player_hit"]
[connection signal="timeout" from="MobSpawner/SpawnTimer" to="MobSpawner" method="_on_spawn_timer_timeout"]
[connection signal="timeout" from="ScoreTimer" to="." method="_on_score_timer_timeout"]
[connection signal="timeout" from="StartTimer" to="." method="_on_start_timer_timeout"]
[connection signal="pressed" from="HUD/RestartButton" to="." method="_on_restart_pressed"]
